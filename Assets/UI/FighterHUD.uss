#hud
{
    width: 100%;
    height: 100%;
}

#player-container
{
    position: absolute;

    left: 20px;
    top: 20px;

    width: 400px;
}

#enemy-container
{
    position: absolute;

    right: 20px;
    top: 20px;

    width: 400px;
}

#player-health,
#enemy-health
{
    height: 30px;
}

#player-health-text,
#enemy-health-text
{
    font-size: 16px;

    margin-top: 4px;
}

#game-over-menu
{
    position: absolute;

    width: 100%;
    height: 100%;

    justify-content: center;
    align-items: center;

    background-color: rgba(0, 0, 0, 0.75);

    display: none;
}

#game-over-panel
{
    width: 400px;

    padding-top: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
    padding-right: 30px;

    background-color: rgb(35, 35, 35);

    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;

    align-items: center;
}

#game-over-title
{
    font-size: 40px;

    color: white;

    unity-font-style: bold;

    margin-bottom: 20px;

    unity-text-align: middle-center;
}

#restart-button
{
    width: 200px;
    height: 50px;

    font-size: 20px;
}